# ===========================================
# WhatsApp Desktop Assistant - Configuration
# ===========================================
# Copiez ce fichier en .env et remplissez vos valeurs
# cp .env.example .env

# --- Mode de fonctionnement ---
# true = pas d'envoi réel de messages (recommandé pour commencer)
SIMULATION_MODE=true

# Mode de réponse: draft_only | manual_validation | auto_reply
RESPONSE_MODE=draft_only

# --- Provider IA ---
# mock = réponses simulées (pas besoin de clé API)
# openai = utiliser OpenAI GPT
# anthropic = utiliser Anthropic Claude
AI_PROVIDER=mock

# --- Clés API (ne jamais committer ce fichier !) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Votre nom sur WhatsApp (pour l'anti-boucle) ---
# Doit correspondre exactement à votre nom affiché dans WhatsApp
WHATSAPP_USER_NAME=

# --- Debug ---
DEBUG=false
