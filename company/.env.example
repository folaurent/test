# Configuration locale — copier en `.env` et remplir. NE PAS versionner `.env`.
# Chargé automatiquement par l'orchestrateur (load_env). Les variables déjà
# présentes dans l'environnement priment sur ce fichier.

# --- Cognition LLM (mode --live) ---
# ANTHROPIC_API_KEY=sk-ant-...
# COMPANY_LLM_MODEL=claude-opus-4-8

# --- Données e-commerce réelles (Shopify, lecture seule) ---
# SHOPIFY_STORE_DOMAIN=ma-boutique.myshopify.com
# SHOPIFY_ADMIN_TOKEN=shpat_...

# --- Reporting Slack / Telegram (agent -> toi) ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...

# --- Dialogue bidirectionnel Slack (toi -> agent, pour --listen) ---
# Nécessite une app Slack avec un bot (scope channels:history) ajoutée au canal.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C0xxxxxxx

# --- Alertes automatiques de fin de cycle ---
# COMPANY_SLACK_ALERTS=1

# --- Autorisation du mode réel ---
# COMPANY_ALLOW_LIVE=1
