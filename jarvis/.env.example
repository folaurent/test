# ===== Jarvis v6 — environment =====
# Copier vers .env et remplir. NE JAMAIS commit .env.

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=          # CSV d'IDs Telegram autorisés (whitelist stricte)
TELEGRAM_ALLOWED_CHAT_IDS=          # CSV de chat IDs

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# ---- LLM providers ----
ANTHROPIC_API_KEY=
# DPA Anthropic ZDR (Zero Data Retention) signé ? true/false — bloquant RGPD
ANTHROPIC_ZDR=false

OPENAI_API_KEY=                     # optionnel (fallback)
OLLAMA_HOST=http://ollama:11434     # fallback local
OLLAMA_FALLBACK_MODEL=llama3.3

# ---- Model routing par usage ----
MODEL_ROUTER_TIER=claude-haiku-4-5-20251001
MODEL_STANDARD_TIER=claude-sonnet-4-6
MODEL_CRITICAL_TIER=claude-opus-4-7

# ---- Budgets ----
BUDGET_LLM_EUR_MONTH=200
BUDGET_INFRA_EUR_MONTH=100
BUDGET_TOKENS_MONTH=50000000
BUDGET_USER_QUESTIONS_PER_DAY=30
BUDGET_HARD_STOP=true

# ---- Dashboard ----
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_AUTH_TOKEN=               # jeton Bearer pour accès dashboard

# ---- Security ----
KILL_SWITCH_TOKEN=                  # secret pour /panic
SECRETS_MASTER_KEY=                 # clef de chiffrement des secrets (fernet)
CANARY_SECRET=                      # secret canary détectable en sortie LLM

# ---- Storage ----
S3_BACKUP_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# ---- Environment ----
ENV=development                     # development | staging | production
LOG_LEVEL=INFO
DRY_RUN=true                        # true par défaut : rien n'est envoyé à l'extérieur
GIT_SIGNING_KEY=                    # clef GPG pour signer les commits Builder

# ---- Scope (NE PAS MODIFIER — double verrou) ----
SCOPE_EXCLUDED_VENTURES=sika,parexlanko
